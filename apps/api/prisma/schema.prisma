generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id          String    @id @default(cuid())
  clerkUserId String    @unique
  name        String
  slug        String    @unique
  description String?
  branding    Json?
  launchedAt  DateTime?
  createdAt   DateTime  @default(now())

  products        Product[]
  orders          Order[]
  customers       Customer[]
  audits          Audit[]
  fixApplications FixApplication[]
  growthPlans     GrowthPlanRecord[]
}

model Product {
  id          String      @id @default(cuid())
  merchantId  String
  merchant    Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  price       Float
  category    String?
  images      String[]
  altText     String?
  createdAt   DateTime    @default(now())

  reviews    Review[]
  orderItems OrderItem[]
}

model Customer {
  id         String  @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  email      String

  orders Order[]

  @@unique([merchantId, email])
}

model Order {
  id         String      @id @default(cuid())
  merchantId String
  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  total      Float
  status     String      @default("paid")
  createdAt  DateTime    @default(now())

  items OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  unitPrice Float
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String?
  rating     Int
  body       String
  createdAt  DateTime @default(now())
}

model Audit {
  id           String   @id @default(cuid())
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  overallScore Int
  scores       Json
  insight      String?
  createdAt    DateTime @default(now())

  issues Issue[]
}

model Issue {
  id          String   @id @default(cuid())
  auditId     String
  audit       Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  category    String
  title       String
  description String
  severity    String
  confidence  Float
  effort      String
  canAutofix  Boolean  @default(false)
  fixSummary  String?
  status      String   @default("open")
  createdAt   DateTime @default(now())

  fixApplications FixApplication[]
}

model FixApplication {
  id           String   @id @default(cuid())
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  issueId      String?
  issue        Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)
  issueTitle   String
  productId    String?
  productTitle String?
  changes      Json
  appliedAt    DateTime @default(now())

  @@index([merchantId, appliedAt])
}

model GrowthPlanRecord {
  id                 String   @id @default(cuid())
  merchantId         String
  merchant           Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  plan               Json
  completedActionIds String[] @default([])
  createdAt          DateTime @default(now())

  @@index([merchantId, createdAt])
}
