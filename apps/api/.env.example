# Clerk — get keys at https://dashboard.clerk.com
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/simba?schema=public"

# AI (Groq) — key from https://console.groq.com/keys
GROQ_API_KEY="gsk_..."
AI_MODEL="llama-3.3-70b-versatile"
# Optional overrides:
# AI_API_KEY="..."
# AI_BASE_URL="https://api.groq.com/openai/v1"

# Server
PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Production (Vercel): your live site, no trailing slash
# WEB_ORIGIN="https://your-app.vercel.app"
# Optional: extra origins, comma-separated
# WEB_ORIGINS="https://www.yourdomain.com"
# Allow Vercel preview deploys (*.vercel.app) — recommended for production API
# ALLOW_VERCEL_PREVIEWS=true

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Seed script — slug of your store (e.g. aman-outdoor). Run: npm run seed
# SEED_MERCHANT_SLUG="your-store-slug"
